rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Users Collection ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
               data.uid == request.auth.uid &&
               data.email is string && data.email.size() <= 256;
      }

      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && 
                      request.resource.data.createdAt == request.time &&
                      request.resource.data.updatedAt == request.time;
      allow update: if isOwner(userId) && isValidUser(request.resource.data) &&
                      request.resource.data.updatedAt == request.time &&
                      request.resource.data.uid == resource.data.uid &&
                      request.resource.data.email == resource.data.email &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'displayName', 'photoURL', 'updatedAt', 'tokens'
                      ]);
    }

    // --- Chats Collection ---
    match /users/{userId}/chats/{chatId} {
      function isValidChat(data) {
        return data.keys().hasAll(['userId', 'title', 'createdAt', 'updatedAt']) &&
               data.userId == userId &&
               data.title is string && data.title.size() <= 500;
      }

      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(chatId) &&
                      isValidChat(request.resource.data) &&
                      request.resource.data.createdAt == request.time &&
                      request.resource.data.updatedAt == request.time;
      allow update: if isOwner(userId) && 
                      isValidChat(request.resource.data) &&
                      request.resource.data.updatedAt == request.time &&
                      request.resource.data.userId == resource.data.userId &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'updatedAt']);
      allow delete: if isOwner(userId);

      // --- Messages Subcollection ---
      match /messages/{messageId} {
        function isValidMessage(data) {
          return data.keys().hasAll(['role', 'text', 'timestamp']) &&
                 data.role in ['user', 'model'] &&
                 data.text is string && data.text.size() <= 10000;
        }

        allow list, get, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(chatId) && 
                        isValidMessage(request.resource.data) &&
                        request.resource.data.timestamp == request.time;
      }
    }
  }
}
